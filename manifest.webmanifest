{
  "name": "Pulso Macro",
  "short_name": "Pulso Macro",
  "description": "La economía argentina y el mundo en un solo tablero: dólares, inflación, tasas, mercados y más.",
  "lang": "es-AR",
  "start_url": "/?app=1",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0e1319",
  "theme_color": "#0e1319",
  "icons": [
    {
      "src": "/icons/anillo-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/anillo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/anillo-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/anillo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "id": "/?app=1",
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://pulsomacro.com.ar/manifest.webmanifest"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  }
}
